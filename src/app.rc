#pragma code_page(65001)
#include <windows.h>
#include "resource.h"
#include <commctrl.h>
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
IDI_BOOK ICON "book.ico"
IDR_UPDATE_KEY RCDATA "update-signing-public.pem"
IDD_ABOUT DIALOGEX 0, 0, 390, 288
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Voltura Books - About"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Voltura Books", IDC_HEADING, 18, 18, 354, 24
    LTEXT "© 2026 Voltura AB - MIT License", -1, 18, 50, 354, 14
    LTEXT "Send books and documents to your Kindle.", -1, 18, 72, 354, 14
    LTEXT "Check for updates to download a newer version. You choose when to install.", IDC_UPDATE_STATUS, 18, 111, 354, 28
    DEFPUSHBUTTON "Check for updates", IDC_UPDATE_CHECK, 18, 145, 164, 26
    PUSHBUTTON "Install update", IDC_UPDATE_OPEN, 194, 145, 178, 26
    PUSHBUTTON "Website", IDC_ABOUT_WEBSITE, 18, 190, 112, 24
    PUSHBUTTON "Report a bug", IDC_ABOUT_ISSUES, 139, 190, 112, 24
    PUSHBUTTON "License", IDC_ABOUT_LICENSE, 260, 190, 112, 24
    PUSHBUTTON "Support Voltura", IDC_ABOUT_SUPPORT, 18, 222, 164, 24
    PUSHBUTTON "Buy me a coffee", IDC_ABOUT_COFFEE, 194, 222, 178, 24
    PUSHBUTTON "Settings", IDC_ABOUT_SETTINGS, 18, 256, 90, 22
    PUSHBUTTON "Close", IDCANCEL, 298, 256, 74, 22
END
IDD_DROP DIALOGEX 0, 0, 440, 330
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Voltura Books - Send a book"
FONT 9, "Segoe UI"
BEGIN
    PUSHBUTTON "About", IDC_ABOUT, 270, 10, 74, 18
    PUSHBUTTON "Settings", IDC_SETTINGS, 352, 10, 74, 18
    LTEXT "Send books to your Kindle", IDC_HEADING, 14, 42, 412, 24, SS_CENTER
    LTEXT "Drop books or documents here, or choose what to send.", -1, 14, 74, 412, 14, SS_CENTER
    CONTROL "Drag books and documents here", IDC_DROP_ZONE, "Static", SS_OWNERDRAW, 14, 98, 412, 126
    DEFPUSHBUTTON "Choose files", IDC_CHOOSE_BOOK, 48, 236, 164, 28
    PUSHBUTTON "Browse folder", IDC_BROWSE_FOLDER, 228, 236, 164, 28
    LTEXT "One email per book. Up to 50 MB per file.", IDC_APPROVAL_HELP, 14, 277, 412, 12, SS_CENTER
    CONTROL "Don't send emails", IDC_PREVIEW_MODE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 14, 303, 300, 18
    PUSHBUTTON "Close", IDCANCEL, 352, 302, 74, 18
END
IDD_BROWSER DIALOGEX 0, 0, 680, 384
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MINIMIZEBOX | WS_MAXIMIZEBOX
EXSTYLE WS_EX_APPWINDOW
CAPTION "Voltura Books - Browse books"
FONT 9, "Segoe UI"
BEGIN
    PUSHBUTTON "Menu", IDC_BROWSER_MENU, 14, 12, 24, 22
    LTEXT "Browse books", IDC_HEADING, 46, 12, 178, 18
    LTEXT "Find your next read", -1, 46, 32, 178, 12
    EDITTEXT IDC_SEARCH, 240, 14, 228, 22, ES_AUTOHSCROLL | WS_TABSTOP
    CONTROL "Clear search", IDC_CLEAR_SEARCH, "Button", BS_OWNERDRAW | WS_TABSTOP, 448, 16, 18, 18
    PUSHBUTTON "Refresh", IDC_REFRESH, 526, 14, 22, 22
    PUSHBUTTON "Choose folder...", IDC_FOLDER, 554, 14, 112, 22
    LTEXT "Choose a folder to see its books and documents.", IDC_FOLDER_PATH, 240, 42, 426, 10, SS_PATHELLIPSIS | SS_NOPREFIX
    CONTROL "Include subfolders", IDC_INCLUDE_SUBFOLDERS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 240, 52, 160, 14
    CONTROL "All types", IDC_ALL_TYPES, "Button", BS_AUTOCHECKBOX | BS_PUSHLIKE | WS_TABSTOP, 14, 72, 48, 18
    CONTROL "EPUB", IDC_TYPE_FIRST + 0, "Button", BS_AUTOCHECKBOX | BS_PUSHLIKE | WS_TABSTOP, 68, 72, 36, 18
    CONTROL "PDF", IDC_TYPE_FIRST + 1, "Button", BS_AUTOCHECKBOX | BS_PUSHLIKE | WS_TABSTOP, 108, 72, 36, 18
    CONTROL "RTF", IDC_TYPE_FIRST + 2, "Button", BS_AUTOCHECKBOX | BS_PUSHLIKE | WS_TABSTOP, 148, 72, 36, 18
    CONTROL "TXT", IDC_TYPE_FIRST + 3, "Button", BS_AUTOCHECKBOX | BS_PUSHLIKE | WS_TABSTOP, 188, 72, 36, 18
    CONTROL "HTML", IDC_TYPE_FIRST + 4, "Button", BS_AUTOCHECKBOX | BS_PUSHLIKE | WS_TABSTOP, 228, 72, 36, 18
    CONTROL "Word", IDC_TYPE_FIRST + 5, "Button", BS_AUTOCHECKBOX | BS_PUSHLIKE | WS_TABSTOP, 268, 72, 36, 18
    CONTROL "Images", IDC_TYPE_FIRST + 6, "Button", BS_AUTOCHECKBOX | BS_PUSHLIKE | WS_TABSTOP, 308, 72, 36, 18
    COMBOBOX IDC_SORT, 468, 72, 110, 90, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_TABSTOP
    CONTROL "List", IDC_VIEW_LIST, "Button", BS_AUTOCHECKBOX | BS_PUSHLIKE | WS_TABSTOP, 588, 72, 36, 18
    CONTROL "Tiles", IDC_VIEW_THUMBS, "Button", BS_AUTOCHECKBOX | BS_PUSHLIKE | WS_TABSTOP, 630, 72, 36, 18
    LISTBOX IDC_FILE_LIST, 14, 100, 214, 239, LBS_NOTIFY | LBS_EXTENDEDSEL | LBS_NOINTEGRALHEIGHT | LBS_OWNERDRAWFIXED | LBS_HASSTRINGS | WS_TABSTOP
    CONTROL "Book thumbnails", IDC_FILE_GRID, "SysListView32", LVS_ICON | LVS_AUTOARRANGE | LVS_SHOWSELALWAYS | LVS_SHAREIMAGELISTS | WS_TABSTOP, 14, 100, 214, 239
    CONTROL "Scroll books", IDC_BOOK_SCROLL, "ScrollBar", SBS_VERT, 228, 100, 8, 239
    CONTROL "Resize file and preview panels", IDC_PANEL_DIVIDER, "Static", SS_NOTIFY, 241, 100, 6, 239
    CONTROL "Book preview", IDC_COVER, "Static", SS_OWNERDRAW, 252, 100, 178, 239
    CONTROL "", IDC_FILENAME, "Static", SS_OWNERDRAW, 446, 100, 220, 141
    PUSHBUTTON "Read in full screen", IDC_FULLSCREEN_READER, 471, 248, 170, 18
    PUSHBUTTON "Download and view", IDC_DOWNLOAD_VIEW, 471, 248, 170, 18
    PUSHBUTTON "Open with default app", IDC_OPEN_FILE, 471, 271, 170, 18
    PUSHBUTTON "Open file location", IDC_OPEN_FOLDER, 471, 294, 170, 18
    PUSHBUTTON "Copy file path", IDC_COPY_PATH, 471, 317, 170, 18
    LTEXT "", IDC_FILE_COUNT, 14, 342, 210, 12
    LTEXT "", IDC_SCAN_STATUS, 260, 342, 406, 12, SS_RIGHT | SS_NOPREFIX
    LTEXT "Hold Ctrl or Shift to select up to 100 files.", IDC_BROWSER_HELP, 14, 358, 398, 12
    DEFPUSHBUTTON "Send book", IDOK, 462, 354, 124, 20
    PUSHBUTTON "Close", IDCANCEL, 596, 354, 70, 20
END
IDD_BROWSER_MENU DIALOGEX 0, 0, 176, 104
STYLE DS_SETFONT | DS_CONTROL | WS_POPUP
EXSTYLE WS_EX_TOOLWINDOW
FONT 9, "Segoe UI"
BEGIN
    PUSHBUTTON "Settings", IDC_MENU_SETTINGS, 8, 8, 160, 26
    PUSHBUTTON "About", IDC_MENU_ABOUT, 8, 39, 160, 26
    PUSHBUTTON "Check for updates", IDC_MENU_CHECK_UPDATES, 8, 70, 160, 26
END
IDD_FORMATTED_FAILURE DIALOGEX 0, 0, 360, 112
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Voltura Books"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Formatted reading is unavailable", IDC_HEADING, 14, 12, 332, 20
    LTEXT "This document could not be rendered within the reader's resource budget, or its formatting is unsupported. You can read its text or open it in another app.", -1, 14, 40, 332, 28
    DEFPUSHBUTTON "Read as text", IDC_READ_AS_TEXT, 126, 78, 100, 22
    PUSHBUTTON "Open with default app", IDC_OPEN_DEFAULT, 234, 78, 112, 22
END
IDD_SETTINGS DIALOGEX 0, 0, 440, 380
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Voltura Books - Settings"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Send to Kindle", IDC_HEADING, 14, 10, 412, 25
    LTEXT "-   Choose how books reach your Kindle.", IDC_SETUP_SUBTITLE, 150, 15, 276, 12
    COMBOBOX IDC_METHOD, 0, 0, 1, 1, CBS_DROPDOWNLIST
    LTEXT "1   Delivery method", IDC_DELIVERY_HEADING, 26, 59, 388, 12
    CONTROL "Send directly", IDC_METHOD_DIRECT, "Button", BS_AUTOCHECKBOX | BS_PUSHLIKE | WS_TABSTOP, 26, 75, 190, 30
    CONTROL "Use my email provider", IDC_METHOD_PROVIDER, "Button", BS_AUTOCHECKBOX | BS_PUSHLIKE | WS_TABSTOP, 224, 75, 190, 30
    LTEXT "", IDC_METHOD_HELP, 26, 111, 388, 22
    LTEXT "2   Kindle destination", IDC_DESTINATION_HEADING, 26, 151, 388, 12
    EDITTEXT IDC_KINDLE, 26, 167, 388, 20, ES_AUTOHSCROLL
    LTEXT "3   Sender account", IDC_ACCOUNT_HEADING, 26, 209, 388, 12
    LTEXT "Sender email", IDC_SENDER_LABEL, 26, 232, 80, 12
    EDITTEXT IDC_SENDER, 112, 227, 302, 20, ES_AUTOHSCROLL
    LTEXT "Email password", IDC_PASSWORD_LABEL, 26, 258, 82, 24
    EDITTEXT IDC_PASSWORD, 112, 253, 250, 20, ES_PASSWORD | ES_AUTOHSCROLL
    PUSHBUTTON "Show password", IDC_PASSWORD_SHOW, 366, 253, 22, 20
    PUSHBUTTON "Copy password", IDC_PASSWORD_COPY, 392, 253, 22, 20
    LTEXT "Your email server will be found automatically.", IDC_DISCOVERY_STATUS, 112, 279, 302, 24, SS_NOPREFIX
    CONTROL "", IDC_PASSWORD_HELP, "SysLink", WS_TABSTOP, 112, 306, 302, 14
    LTEXT "Approve your sender email in Amazon's Personal Document settings before sending.", IDC_APPROVAL_HELP, 26, 384, 388, 24
    CONTROL "Advanced server settings", IDC_ADVANCED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 26, 430, 388, 16
    LTEXT "Mail server", IDC_HOST_LABEL, 26, 452, 72, 12
    LTEXT "", IDC_HOST_ERROR, 100, 474, 314, 24
    EDITTEXT IDC_HOST, 100, 450, 214, 20, ES_AUTOHSCROLL
    LTEXT "Port", IDC_PORT_LABEL, 324, 452, 30, 12
    EDITTEXT IDC_PORT, 354, 450, 60, 20, ES_AUTOHSCROLL
    LTEXT "Connection", IDC_SECURITY_LABEL, 26, 484, 72, 12
    COMBOBOX IDC_SECURITY, 100, 480, 314, 60, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_TABSTOP
    PUSHBUTTON "About", IDC_SETTINGS_ABOUT, 14, 522, 90, 22
    DEFPUSHBUTTON "Save", IDOK, 276, 522, 70, 22
    PUSHBUTTON "Cancel", IDCANCEL, 354, 522, 72, 22
    CONTROL "Scroll settings", IDC_SETTINGS_SCROLL, "ScrollBar", SBS_VERT, 430, 0, 8, 380
END
IDD_SEND DIALOGEX 0, 0, 440, 332
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Voltura Books - Send to Kindle"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Sending to Kindle", IDC_HEADING, 14, 14, 412, 26, SS_CENTER
    LTEXT "Your book, one step closer to your next read.", -1, 14, 46, 412, 14, SS_CENTER
    CONTROL "Book cover", IDC_COVER, "Static", SS_OWNERDRAW, 26, 76, 94, 126
    CONTROL "", IDC_FILENAME, "Static", SS_OWNERDRAW, 140, 76, 272, 126
    LTEXT "Sending your book...", IDC_STATUS, 26, 228, 386, 28
    LTEXT "Sending by email. Amazon handles delivery to your Kindle.", IDC_SEND_HELP, 26, 258, 386, 14
    CONTROL "", IDC_PROGRESS, "msctls_progress32", 8, 26, 278, 386, 7
    PUSHBUTTON "Settings", IDC_SETTINGS, 14, 304, 72, 18
    PUSHBUTTON "Skip", IDC_SKIP, 100, 304, 72, 18
    DEFPUSHBUTTON "Retry", IDC_RETRY, 268, 304, 72, 18
    PUSHBUTTON "Cancel", IDCANCEL, 354, 304, 72, 18
END
1 VERSIONINFO
FILEVERSION 0,1,5,0
PRODUCTVERSION 0,1,5,0
FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "Voltura AB"
   VALUE "LegalCopyright", "© 2026 Voltura AB"
   VALUE "FileDescription", "Voltura Books"
   VALUE "FileVersion", "0.1.5"
   VALUE "ProductName", "Voltura Books"
   VALUE "ProductVersion", "0.1.5"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
